{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":semanticCommits"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "enabledManagers": [
    "pep621",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "npm",
    "nvm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv version pinned in workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "UV_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Media server images pinned by digest in the end-to-end scripts",
      "managerFilePatterns": [
        "/^\\.github/scripts/e2e-.+\\.(sh|py)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n[A-Z_]+ ?= ?\"[^\":]+:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group Python dev tooling",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "groupName": "python dev tooling"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Keep uv, its image and the build backend in step",
      "matchPackageNames": [
        "astral-sh/uv",
        "astral/uv",
        "uv_build"
      ],
      "groupName": "uv"
    },
    {
      "description": "Group the web console's dependencies",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/package.json"
      ],
      "groupName": "web console dependencies"
    },
    {
      "description": "Keep the Node build stage and .nvmrc in step",
      "matchPackageNames": [
        "node"
      ],
      "groupName": "node"
    }
  ]
}
